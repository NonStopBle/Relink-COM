        <mxCell id="title" value="ReLink -- Full System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="10" width="640" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Legend&#10;— solid: data path (UDP or shared memory)&#10;- - dashed: discovery / registration (control plane)&#10;·· dotted: multicast beacon (Mode B)&#10;– · fallback: NAT relay / --ipc CLI path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1290" y="10" width="300" height="90" as="geometry"/></mxCell><mxCell id="naOuter" value="Node A -- Publisher&#10;(C++ header-only lib  OR  Python stdlib binding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontSize=15;fontStyle=1;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="320" height="560" as="geometry"/></mxCell><mxCell id="naApp" value="Application code&#10;(pub.cpp / hello_relink.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="280" height="45" as="geometry"/></mxCell><mxCell id="naApi" value="RelinkNode API&#10;advertise() / publish() / subscribe() / spin()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="280" height="45" as="geometry"/></mxCell><mxCell id="naDisc" value="Discovery&#10;Mode A: rlcore_client.hpp / register.hpp&#10;Mode B: beacon.hpp / multicast_discovery.hpp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="280" height="55" as="geometry"/></mxCell><mxCell id="naTransport" value="UDP Transport (udp_transport.hpp)&#10;dedicated data thread, CPU pin, SCHED_FIFO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="280" height="50" as="geometry"/></mxCell><mxCell id="naShm" value="Same-host IPC (shm_transport.hpp)&#10;advertise_local_ipc / publish_local_ipc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="280" height="45" as="geometry"/></mxCell><mxCell id="naWire" value="Wire protocol (wire.hpp) -- fixed-layout struct, byte-exact across languages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="445" width="280" height="40" as="geometry"/></mxCell><mxCell id="naPlatform" value="platform.hpp -- Linux / macOS / Windows socket + threading shim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="280" height="40" as="geometry"/></mxCell><mxCell id="naCrypto" value="crypto.hpp -- AES-256-GCM (rlcore signaling only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="280" height="30" as="geometry"/></mxCell><mxCell id="nbOuter" value="Node B -- Subscriber&#10;(C++ header-only lib  OR  Python stdlib binding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontSize=15;fontStyle=1;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="320" height="560" as="geometry"/></mxCell><mxCell id="nbApp" value="Application code&#10;(sub.cpp / hello_relink.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="280" height="45" as="geometry"/></mxCell><mxCell id="nbApi" value="RelinkNode API&#10;advertise() / publish() / subscribe() / spin()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="190" width="280" height="45" as="geometry"/></mxCell><mxCell id="nbDisc" value="Discovery&#10;Mode A: rlcore_client.hpp / register.hpp&#10;Mode B: beacon.hpp / multicast_discovery.hpp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="280" height="55" as="geometry"/></mxCell><mxCell id="nbTransport" value="UDP Transport (udp_transport.hpp)&#10;dedicated data thread, CPU pin, SCHED_FIFO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="320" width="280" height="50" as="geometry"/></mxCell><mxCell id="nbShm" value="Same-host IPC (shm_transport.hpp)&#10;advertise_local_ipc / publish_local_ipc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="385" width="280" height="45" as="geometry"/></mxCell><mxCell id="nbWire" value="Wire protocol (wire.hpp) -- fixed-layout struct, byte-exact across languages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="445" width="280" height="40" as="geometry"/></mxCell><mxCell id="nbPlatform" value="platform.hpp -- Linux / macOS / Windows socket + threading shim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="280" height="40" as="geometry"/></mxCell><mxCell id="nbCrypto" value="crypto.hpp -- AES-256-GCM (rlcore signaling only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="555" width="280" height="30" as="geometry"/></mxCell><mxCell id="rlcoreDaemon" value="relink-rlcore daemon&#10;registration (Mode A) + relay fallback (--relay / --nat)&#10;port 8445 default, optional --encrypt-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="300" height="70" as="geometry"/></mxCell><mxCell id="relayNote" value="NAT traversal: UDP hole punching (--nat)&#10;falls back to relayed forwarding through&#10;rlcore (Python) / relink-relay (C++, separate binary)&#10;when a direct hole-punch fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="300" height="65" as="geometry"/></mxCell><mxCell id="multicastCloud" value="LAN Multicast Beacon&#10;(Mode B -- no daemon)&#10;startup burst, then sparse&#10;~30-60s reannounce" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="300" height="80" as="geometry"/></mxCell><mxCell id="shmRing" value="Shared-memory ring&#10;(same host only, no socket)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="300" height="55" as="geometry"/></mxCell><mxCell id="rlTopic" value="rl_topic / rltopic CLI&#10;list / info / echo / hz / bw / pub&#10;--rlcore-ip (network)  or  --ipc (shared mem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="495" width="300" height="65" as="geometry"/></mxCell><mxCell id="pyNote" value="Python binding (relink_py): stdlib-only&#10;(ctypes + socket + struct), no C-extension --&#10;proven wire-compatible with the C++ node in&#10;both directions, both discovery modes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="300" height="70" as="geometry"/></mxCell>
